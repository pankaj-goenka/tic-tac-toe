{
    "name": "tic-tac-toe-e2e",
    "version": "1.0.0",
    "private": true,
    "description": "End-to-end test automation for the Tic-Tac-Toe web app — WebdriverIO + TypeScript, Dockerized, with Allure reporting.",
    "author": "pankaj-goenka",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "serve": "http-server app -o -c-1 -p 8080",
        "test": "wdio run wdio.conf.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "docker:up": "docker compose up --detach app",
        "docker:down": "docker compose down --remove-orphans",
        "docker:test": "docker compose run --build --rm tests",
        "allure:generate": "allure generate --clean --output allure-report allure-results",
        "allure:open": "allure open allure-report",
        "allure:serve": "allure serve allure-results"
    },
    "devDependencies": {
        "@wdio/cli": "^9.5.0",
        "@wdio/local-runner": "^9.5.0",
        "@wdio/mocha-framework": "^9.5.0",
        "@wdio/globals": "^9.5.0",
        "@wdio/spec-reporter": "^9.5.0",
        "@wdio/allure-reporter": "^9.27.2",
        "allure-commandline": "^2.42.0",
        "expect-webdriverio": "^5.6.5",
        "typescript": "^5.7.2",
        "tsx": "^4.19.2",
        "@types/node": "^22.10.0",
        "eslint": "^9.17.0",
        "@eslint/js": "^9.17.0",
        "typescript-eslint": "^8.18.0",
        "eslint-config-prettier": "^9.1.0",
        "prettier": "^3.4.2",
        "http-server": "^14.1.1"
    },
    "overrides": {
        "serialize-javascript": "^7.0.5"
    }
}
