FROM node:22-bookworm-slim

# System Chromium + driver (used instead of WDIO's auto-managed browser), plus a
# headless JRE so the Allure HTML report can be generated inside the container.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        chromium \
        chromium-driver \
        ca-certificates \
        fonts-liberation \
        default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

ENV CHROME_BIN=/usr/bin/chromium
ENV CHROMEDRIVER_BIN=/usr/bin/chromedriver

WORKDIR /app

# Install deps in their own layer so source edits don't bust the npm cache.
COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json wdio.conf.ts ./
COPY src ./src

# Run the suite, then always build the Allure report — preserving WDIO's exit code
# so a failed run still surfaces as red. allure-report/ is mounted out via compose.
CMD ["sh", "-c", "npx wdio run wdio.conf.ts; code=$?; npx allure generate allure-results --clean -o allure-report; exit $code"]
